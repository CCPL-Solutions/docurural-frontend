{
  "name": "docurural-frontend",
  "version": "1.0.1-SNAPSHOT",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:develop": "ng serve --configuration develop",
    "start:qa": "ng serve --configuration qa",
    "start:en": "ng serve --configuration en",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "extract-i18n": "ng extract-i18n",
    "test": "ng test",
    "test:ci": "ng test --no-watch --coverage",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss,json}\"",
    "lint": "ng lint",
    "check:styles": "node scripts/check-styles.mjs",
    "e2e": "ng e2e",
    "e2e:ci": "ng e2e --test-project functional"
  },
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@angular/animations": "^21.2.10",
    "@angular/cdk": "^21.2.8",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/localize": "^21.2.10",
    "@angular/material": "^21.2.8",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "chart.js": "^4.5.1",
    "ng2-charts": "^10.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.8",
    "@angular/cli": "^21.2.8",
    "@angular/compiler-cli": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@vitest/coverage-v8": "^4.1.10",
    "angular-eslint": "21.4.0",
    "eslint": "^10.3.0",
    "jsdom": "^28.0.0",
    "playwright-ng-schematics": "^21.1.1",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.59.2",
    "vitest": "^4.0.8"
  }
}
